+}
+
+$alert_message = '';
+$alert_type = 'error';
+
+// افزودن کامنت
+if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action'])) {
+    if ($_POST['action'] === 'add_comment') {
