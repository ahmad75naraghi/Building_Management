-        $otherCookies = [];
-        foreach (headers_list() as $h) {
-            if (0 !== stripos($h, 'Set-Cookie:')) {
-                continue;
-            }
-            if (11 === strpos($h, $sessionCookiePrefix, 11)) {
-                $sessionCookie = $h;
-
-                if (11 !== strpos($h, $sessionCookieWithId, 11)) {
-                    $otherCookies[] = $h;
-                }
-            } else {
-                $otherCookies[] = $h;
-            }
-        }
-        if (null === $sessionCookie) {
-            return null;
-        }
-
-        header_remove('Set-Cookie');
