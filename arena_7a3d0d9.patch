-                (?!\s)
-                    (?:
-                        # quoted-string
-                        "(?:[^"\\\\]|\\\\.)*(?:"|\\\\|$)
-                    |
-                        # token
-                        [^"'.$quotedSeparators.']+
-                    )+
-                (?<!\s)
