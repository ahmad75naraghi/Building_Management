-    public function handle(Request $request, callable $next): mixed
-    {
-        $path = $request->getPathInfo();
-        
-        // اضافه شدن مسیرهای دارای پوشه /b به لیست سفید امنیتی
-        $publicPaths = [
-            '/api/auth/login',
