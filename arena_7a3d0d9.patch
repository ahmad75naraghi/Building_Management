-            . $this->pStatic($node->static)
-            . 'fn' . ($node->byRef ? '&' : '')
-            . '(' . $this->pParams($node->params) . ')'
-            . (null !== $node->returnType ? ': ' . $this->p($node->returnType) : '')
-            . ' => ',
-            $node->expr, $precedence, $lhsPrecedence);
