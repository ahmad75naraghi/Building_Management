-
-                foreach ($issues as $issue) {
-                    $writer->startElement('issue');
-                    $writer->writeCdata($issue->description());
-                    $writer->endElement();
-                }
-
-                $writer->endElement();
-            }
-
-            $writer->endElement();
-        }
