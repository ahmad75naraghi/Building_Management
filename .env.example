# ============================================================
#  نمونه تنظیمات محیطی — این فایل را به .env کپی کنید
#      cp .env.example .env
#  فایل .env هرگز نباید در گیت ثبت شود (در .gitignore هست).
# ============================================================

# ---------------------------- محیط اجرا ----------------------------
# مقادیر مجاز: development | testing | production
# پیش‌فرض production است تا فراموش‌کردنش باعث افشای جزئیات خطا نشود.
APP_ENV=production

# آدرس پایه برنامه — برای ساخت لینک دعوت در پیامک استفاده می‌شود
APP_URL=https://file.falnic.com/b


# ---------------------------- امنیت (اجباری) ----------------------------
# کلید امضای JWT — حداقل ۳۲ کاراکتر.
# یک کلید تصادفی بسازید:
#     openssl rand -base64 48
# ⚠️ اگر تنظیم نشود، برنامه در محیط تولید بالا نمی‌آید.
JWT_SECRET=

# ---------------------------- پایگاه‌داده ----------------------------
DB_DSN=mysql:host=localhost;dbname=file_b;charset=utf8mb4
DB_USERNAME=file_b
# ⚠️ اجباری در محیط تولید
DB_PASSWORD=


# ---------------------------- پیامک ----------------------------
# اطلاعات پنل ملی‌پیامک — فقط از همین متغیرها خوانده می‌شود و هیچ پیش‌فرضی در کد نیست.
# اگر این سه متغیر خالی باشند، سرویس پیامک «غیرفعال» می‌شود و ارسال‌ها بی‌صدا رد می‌شوند.
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_BODY_ID=
# پترن جداگانه برای یادآوری رویدادها (اختیاری)
# MELIPAYAMAK_REMINDER_BODY_ID=
# پترن جداگانه برای یادآوری بدهکاران (اختیاری — اگر نباشد با متن کامل ارسال می‌شود)
# آرگومان‌های پترن به ترتیب: نام، مبلغ، نام ساختمان، مهلت
# MELIPAYAMAK_DEBTOR_BODY_ID=
# حداقل بدهی (تومان) برای ورود به فهرست یادآوری پیامکی — کمتر از این نادیده گرفته می‌شود
SMS_DEBTOR_MIN_AMOUNT=10000
# قالب پیامک یادآوری بدهی — جای‌دارها: {نام} {مبلغ} {ساختمان} {مهلت}
# اگر خالی باشد قالب پیش‌فرض استفاده می‌شود.
# SMS_DEBTOR_TEMPLATE=کاربر گرامی {نام}، مانده بدهی شما بابت شارژ ساختمان «{ساختمان}» مبلغ {مبلغ} تومان است. لطفاً تا {مهلت} نسبت به پرداخت اقدام فرمایید.


# ---------------------------- لاگ ----------------------------
# مسیر پوشه لاگ (پیش‌فرض: storage/logs)
# APP_LOG_DIR=
# حداقل سطح ثبت: debug | info | warning | error | critical
APP_LOG_LEVEL=info


# ---------------------------- توسعه ----------------------------
# فقط در توسعه: با مقدار 1 کد یک‌بارمصرف در پاسخ API برگردانده می‌شود
# ⚠️ هرگز در محیط تولید فعال نکنید.
# OTP_DEBUG=1

# غیرفعال‌کردن بررسی گواهی SSL در تماس‌های داخلی (فقط توسعه محلی)
# ⚠️ هرگز در محیط تولید فعال نکنید.
# API_INSECURE_SSL=1

# ---------------------------- صف کار پس‌زمینه ----------------------------
# درایور صف: «sync» = اجرای درجا (پیش‌فرض، بدون تغییر رفتار)؛
# «database» = ثبت در جدول jobs و اجرای با کران (مناسب هاست اشتراکی).
# فعال‌سازی: مقدار «database» + کران هر دقیقه:  * * * * * php /path/scripts/queue.php
# QUEUE_DRIVER=sync

# ---------------------------- اعلان فوری وب (Web Push) ----------------------------
# خروجی اسکریپت  php scripts/vapid_generate.php  را اینجا قرار دهید.
# تا وقتی این کلیدها تنظیم نشوند، وب‌پوش به‌صورت بی‌صدا غیرفعال می‌ماند.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
