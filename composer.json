{
    "name": "building-management/building-mgmt",
    "description": "Professional Building Management System - Pure PHP 8.3, REST API, JWT, MVC",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*",
        "firebase/php-jwt": "^6.10",
        "predis/predis": "^2.2",
        "symfony/http-foundation": "^7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "migrate": "php scripts/migrator.php",
        "serve": "php -S 0.0.0.0:8000 -t public/"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
